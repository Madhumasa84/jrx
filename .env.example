# ==============================================================================
# JEV Reflex / JRX - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and supply your configuration:
#   cp .env.example .env

# TypeSafe API Key (BYOK) - Required for live JEV semantic evaluations
# Obtain from your TypeSafe account / portal
TYPESAFE_API_KEY=

# Debug mode for JEV Reflex broker and CLI (1 to enable, 0 to disable)
JRX_DEBUG=0
